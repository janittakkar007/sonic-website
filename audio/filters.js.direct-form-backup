export function createProfileNode(context, profileName) {
  if (context.sampleRate !== FILTER_SAMPLE_RATE) {
    throw new Error(
      `SONIC filters require a ${
        FILTER_SAMPLE_RATE
      } Hz audio context; this browser created ${context.sampleRate} Hz.`
    );
  }

  const profile = FILTER_PROFILES[profileName];
  if (!profile) throw new Error(`Unknown filter profile: ${profileName}`);

  const filter = context.createIIRFilter(
    profile.feedforward,
    profile.feedback
  );

  const gain = context.createGain();
  gain.gain.value = profile.gain;

  filter.connect(gain);
  return { input: filter, output: gain };
}
